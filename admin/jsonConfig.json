{
    "i18n": true,
    "type": "panel",
    "items": {
        "_header": {
            "type": "header",
            "text": "Prometheus Adapter Settings",
            "size": 3,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "_info": {
            "type": "staticText",
            "text": "Configure one or more Prometheus servers and queries. Metrics, labels and values are loaded live from the server - no PromQL knowledge required.",
            "style": {
                "marginBottom": 16
            },
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "requestTimeout": {
            "type": "number",
            "label": "Request timeout (s)",
            "min": 1,
            "max": 300,
            "default": 10,
            "help": "HTTP timeout for all Prometheus API requests",
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "username": {
            "type": "text",
            "label": "Username (optional)",
            "help": "Basic auth user applied to all sources",
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "password": {
            "type": "password",
            "label": "Password (optional)",
            "repeat": false,
            "help": "Basic auth password applied to all sources. Save before using the live dropdowns.",
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "_sourcesHeader": {
            "type": "header",
            "text": "Sources",
            "size": 4,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "sources": {
            "type": "accordion",
            "titleAttr": "name",
            "clone": true,
            "xs": 12,
            "sm": 12,
            "items": [
                {
                    "attr": "enabled",
                    "type": "checkbox",
                    "label": "Enabled",
                    "default": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 2,
                    "lg": 2,
                    "xl": 2
                },
                {
                    "attr": "name",
                    "type": "text",
                    "label": "Name",
                    "default": "",
                    "help": "Display name; also used as default datapoint path",
                    "xs": 12,
                    "sm": 12,
                    "md": 5,
                    "lg": 4,
                    "xl": 4
                },
                {
                    "attr": "url",
                    "type": "text",
                    "label": "Prometheus URL",
                    "default": "",
                    "help": "Base URL of the Prometheus server, e.g. http://192.168.1.10:9090",
                    "xs": 12,
                    "sm": 12,
                    "md": 5,
                    "lg": 6,
                    "xl": 6
                },
                {
                    "attr": "pollInterval",
                    "type": "number",
                    "label": "Poll interval (s)",
                    "min": 5,
                    "max": 86400,
                    "default": 60,
                    "help": "How often this query is executed (seconds)",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                {
                    "attr": "targetPath",
                    "type": "text",
                    "label": "Target datapoint path",
                    "default": "",
                    "help": "States are written below this path, e.g. servers.nas. Empty = derived from name",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 5,
                    "xl": 5
                },
                {
                    "attr": "metric",
                    "type": "selectSendTo",
                    "label": "Metric",
                    "command": "getMetricNames",
                    "jsonData": "{\"url\": \"${data.url}\"}",
                    "alsoDependsOn": [
                        "url"
                    ],
                    "manual": false,
                    "noTranslation": true,
                    "help": "Metric list is loaded live from the Prometheus server",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 4,
                    "newLine": true,
                    "xl": 4
                },
                {
                    "attr": "aggregation",
                    "type": "select",
                    "label": "Aggregation",
                    "default": "avg",
                    "options": [
                        {
                            "label": "Last value (no aggregation)",
                            "value": "none"
                        },
                        {
                            "label": "Average",
                            "value": "avg"
                        },
                        {
                            "label": "Sum",
                            "value": "sum"
                        },
                        {
                            "label": "Minimum",
                            "value": "min"
                        },
                        {
                            "label": "Maximum",
                            "value": "max"
                        },
                        {
                            "label": "Count of series",
                            "value": "count"
                        }
                    ],
                    "help": "How multiple series are combined",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                {
                    "attr": "groupBy",
                    "type": "selectSendTo",
                    "label": "Group by labels",
                    "command": "getLabels",
                    "multiple": true,
                    "jsonData": "{\"url\": \"${data.url}\", \"metric\": \"${data.metric}\"}",
                    "alsoDependsOn": [
                        "url",
                        "metric",
                        "aggregation"
                    ],
                    "manual": false,
                    "noTranslation": true,
                    "hidden": "data.aggregation === 'none'",
                    "help": "One state per label value combination is created",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                {
                    "attr": "_filterHeader",
                    "type": "header",
                    "text": "Filters (optional)",
                    "size": 5,
                    "xs": 12,
                    "sm": 12,
                    "newLine": true,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                {
                    "attr": "filter1Label",
                    "type": "selectSendTo",
                    "label": "Filter label",
                    "command": "getLabels",
                    "jsonData": "{\"url\": \"${data.url}\", \"metric\": \"${data.metric}\"}",
                    "alsoDependsOn": [
                        "url",
                        "metric"
                    ],
                    "manual": false,
                    "noTranslation": true,
                    "help": "Prometheus label to filter on",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "xl": 3
                },
                {
                    "attr": "filter1Value",
                    "type": "selectSendTo",
                    "label": "Filter value",
                    "command": "getLabelValues",
                    "jsonData": "{\"url\": \"${data.url}\", \"metric\": \"${data.metric}\", \"label\": \"${data.filter1Label}\"}",
                    "alsoDependsOn": [
                        "url",
                        "metric",
                        "filter1Label"
                    ],
                    "manual": false,
                    "noTranslation": true,
                    "hidden": "!data.filter1Label",
                    "help": "Only series with this label value are included",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "xl": 3
                },
                {
                    "attr": "filter2Label",
                    "type": "selectSendTo",
                    "label": "Filter label",
                    "command": "getLabels",
                    "jsonData": "{\"url\": \"${data.url}\", \"metric\": \"${data.metric}\"}",
                    "alsoDependsOn": [
                        "url",
                        "metric",
                        "filter1Label"
                    ],
                    "manual": false,
                    "noTranslation": true,
                    "help": "Prometheus label to filter on",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "hidden": "!data.filter1Label",
                    "xl": 3
                },
                {
                    "attr": "filter2Value",
                    "type": "selectSendTo",
                    "label": "Filter value",
                    "command": "getLabelValues",
                    "jsonData": "{\"url\": \"${data.url}\", \"metric\": \"${data.metric}\", \"label\": \"${data.filter2Label}\"}",
                    "alsoDependsOn": [
                        "url",
                        "metric",
                        "filter2Label"
                    ],
                    "manual": false,
                    "noTranslation": true,
                    "hidden": "!data.filter2Label",
                    "help": "Only series with this label value are included",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "xl": 3
                },
                {
                    "attr": "filter3Label",
                    "type": "selectSendTo",
                    "label": "Filter label",
                    "command": "getLabels",
                    "jsonData": "{\"url\": \"${data.url}\", \"metric\": \"${data.metric}\"}",
                    "alsoDependsOn": [
                        "url",
                        "metric",
                        "filter2Label"
                    ],
                    "manual": false,
                    "noTranslation": true,
                    "help": "Prometheus label to filter on",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "hidden": "!data.filter2Label",
                    "xl": 3
                },
                {
                    "attr": "filter3Value",
                    "type": "selectSendTo",
                    "label": "Filter value",
                    "command": "getLabelValues",
                    "jsonData": "{\"url\": \"${data.url}\", \"metric\": \"${data.metric}\", \"label\": \"${data.filter3Label}\"}",
                    "alsoDependsOn": [
                        "url",
                        "metric",
                        "filter3Label"
                    ],
                    "manual": false,
                    "noTranslation": true,
                    "hidden": "!data.filter3Label",
                    "help": "Only series with this label value are included",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "xl": 3
                },
                {
                    "attr": "filter4Label",
                    "type": "selectSendTo",
                    "label": "Filter label",
                    "command": "getLabels",
                    "jsonData": "{\"url\": \"${data.url}\", \"metric\": \"${data.metric}\"}",
                    "alsoDependsOn": [
                        "url",
                        "metric",
                        "filter3Label"
                    ],
                    "manual": false,
                    "noTranslation": true,
                    "help": "Prometheus label to filter on",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "hidden": "!data.filter3Label",
                    "xl": 3
                },
                {
                    "attr": "filter4Value",
                    "type": "selectSendTo",
                    "label": "Filter value",
                    "command": "getLabelValues",
                    "jsonData": "{\"url\": \"${data.url}\", \"metric\": \"${data.metric}\", \"label\": \"${data.filter4Label}\"}",
                    "alsoDependsOn": [
                        "url",
                        "metric",
                        "filter4Label"
                    ],
                    "manual": false,
                    "noTranslation": true,
                    "hidden": "!data.filter4Label",
                    "help": "Only series with this label value are included",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "xl": 3
                },
                {
                    "attr": "filter5Label",
                    "type": "selectSendTo",
                    "label": "Filter label",
                    "command": "getLabels",
                    "jsonData": "{\"url\": \"${data.url}\", \"metric\": \"${data.metric}\"}",
                    "alsoDependsOn": [
                        "url",
                        "metric",
                        "filter4Label"
                    ],
                    "manual": false,
                    "noTranslation": true,
                    "help": "Prometheus label to filter on",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "hidden": "!data.filter4Label",
                    "xl": 3
                },
                {
                    "attr": "filter5Value",
                    "type": "selectSendTo",
                    "label": "Filter value",
                    "command": "getLabelValues",
                    "jsonData": "{\"url\": \"${data.url}\", \"metric\": \"${data.metric}\", \"label\": \"${data.filter5Label}\"}",
                    "alsoDependsOn": [
                        "url",
                        "metric",
                        "filter5Label"
                    ],
                    "manual": false,
                    "noTranslation": true,
                    "hidden": "!data.filter5Label",
                    "help": "Only series with this label value are included",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "xl": 3
                },
                {
                    "attr": "preview",
                    "type": "textSendTo",
                    "label": "Live preview",
                    "command": "previewQuery",
                    "container": "div",
                    "copyToClipboard": true,
                    "jsonData": "{\"url\": \"${data.url}\", \"metric\": \"${data.metric}\", \"aggregation\": \"${data.aggregation}\", \"groupBy\": \"${data.groupBy}\", \"filter1Label\": \"${data.filter1Label}\", \"filter1Value\": \"${data.filter1Value}\", \"filter2Label\": \"${data.filter2Label}\", \"filter2Value\": \"${data.filter2Value}\", \"filter3Label\": \"${data.filter3Label}\", \"filter3Value\": \"${data.filter3Value}\", \"filter4Label\": \"${data.filter4Label}\", \"filter4Value\": \"${data.filter4Value}\", \"filter5Label\": \"${data.filter5Label}\", \"filter5Value\": \"${data.filter5Value}\"}",
                    "alsoDependsOn": [
                        "url",
                        "metric",
                        "aggregation",
                        "groupBy",
                        "filter1Label",
                        "filter1Value",
                        "filter2Label",
                        "filter2Value",
                        "filter3Label",
                        "filter3Value",
                        "filter4Label",
                        "filter4Value",
                        "filter5Label",
                        "filter5Value"
                    ],
                    "xs": 12,
                    "sm": 12,
                    "newLine": true,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            ],
            "md": 12,
            "lg": 12,
            "xl": 12
        }
    }
}
